# Documentation directories for rebuilding an index (not used by chat retrieval).
LANGCHAIN_GUIDES_DIR=./data/raw/langchain/guides
LANGCHAIN_API_DIR=./data/raw/langchain/api
DOCKER_DOCS_DIR=./data/raw/docker
GIT_DOCS_DIR=./data/raw/git

# llama_cpp: local llama-server /v1/embeddings
# ollama:    local Ollama /api/embed
# sentence_transformers: load a local HF/SentenceTransformers model with PyTorch
EMBEDDING_BACKEND=ollama

# Full embedding endpoint: Ollama /api/embed or llama.cpp /v1/embeddings.
# For llama.cpp, for example: http://127.0.0.1:8081/v1/embeddings
EMBEDDING_API_URL=http://127.0.0.1:11434/api/embed
EMBEDDING_API_MODEL=embeddinggemma-2
EMBEDDING_HTTP_TIMEOUT=180

# For sentence_transformers, use a complete local HF/SentenceTransformers
# model directory (including tokenizer files), not a GGUF file.
MODEL_ID="/path/to/local/embeddinggemma-2"
MODEL_REVISION=main
# Used only during document chunking; GGUF query tokenization runs in the inference server.
TOKENIZER_ID="/path/to/directory/with/tokenizer/files"
DEVICE=auto
## Floating point precision for the model. Options: auto, bfloat16, float32
MODEL_DTYPE=bfloat16
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=16
NORMALIZE_EMBEDDINGS=true
# Set these before startup when another entrypoint imports Hugging Face first.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
## Refer to "Prefix Notation & Usage" section at https://huggingface.co/google/embeddinggemma-2
QUERY_PROMPT_NAME=QuestionAnswering

# Inference backend selection is independent of EMBEDDING_BACKEND.
# Possible values: ollama, llama_cpp.
INFERENCE_BACKEND=ollama
INFERENCE_MODEL=gemma4:e2b
# For llama.cpp, set the backend to llama_cpp, the model to its served alias,
# and the base URL to http://127.0.0.1:8082/v1 (not /chat/completions).
INFERENCE_BASE_URL=http://localhost:11434
INFERENCE_TEMPERATURE=0.2
# Use local URLs and already installed models for offline operation.
# Restart FastAPI after changing these settings.

# Chunking details (index creation only).
CHUNK_TARGET_TOKENS=768
CHUNK_OVERLAP_TOKENS=100
CHUNK_MAX_TOKENS=1024

# ChromaDB details
# Extract the bundle here; relative paths resolve from the project root.
CHROMA_PATH=./data/chroma
COLLECTION_NAME=developer_docs
# Maximum number of existing chunks to pass to chat inference.
RETRIEVAL_TOP_K=4
## How many embeddings to process in a single batch when inserting into ChromaDB
CHROMA_BATCH_SIZE=128
## Information about the completed index
BUILD_METADATA_PATH=./data/build_metadata.json

# How many documents to ingest (0 = all)
MAX_FILES=0